{
  "name": "anezkabereckova.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "photos": "node scripts/photos.mjs",
    "video": "node scripts/hero-video.mjs",
    "assets": "npm run photos && npm run video",
    "generate": "node scripts/icons.mjs && node scripts/og.mjs && node scripts/launchkit.mjs",
    "prebuild": "npm run generate",
    "postbuild": "node scripts/sitemap.mjs && node scripts/sw.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.62.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss": "^8.4.32",
    "prettier": "^3.7.4",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3"
  }
}
